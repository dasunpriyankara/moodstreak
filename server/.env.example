# Copy to .env (never commit .env). On Render set these in the dashboard instead.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/moodstreak?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string   # e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORT=8443
# Local HTTPS (run: npm run gen-cert)
TLS_KEY_PATH=certs/key.pem
TLS_CERT_PATH=certs/cert.pem
# On Render use this instead of the two TLS paths above:
# BEHIND_TLS_PROXY=true
# Extra allowed web origins for CORS (comma separated)
CORS_ORIGINS=
